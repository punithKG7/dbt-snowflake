# Example dbt model - Marts layer
version: 2

models:
  - name: fct_orders
    description: Fact table for orders
    columns:
      - name: order_id
        description: Unique order identifier
        tests:
          - unique
          - not_null
      - name: customer_id
        description: Foreign key to customers
        tests:
          - relationships:
              to: ref('dim_customers')
              field: customer_id
